# 倪师 AI · 环境变量模板
#
# 用法（在仓库根目录）：
#     cp .env.example .env
#     vim .env                      # 至少填 NHX_LLM_API_KEY
#
# ⚠️ 本文件是**模板，会入库**：只放占位符，绝不写真实密钥。
# ⚠️ `.env` 是私密配置，已在 .gitignore 中排除。它不是「系统自动读取」的，
#    而是 `Config()` 启动时主动读 `仓库根/.env`（真实环境变量优先，不覆盖），
#    所以本地 `python3 src/nhx_app/server.py` 也能生效。
#
# 排查是否真的生效：python3 src/nhx_app/server.py --check

# ── 服务监听 ────────────────────────────────────────────────────────────────
# 本机开发用 127.0.0.1；与 Nginx 同机部署也保持 127.0.0.1
# （deploy/nginx.conf 的 upstream 指向 127.0.0.1:8790）。
# 要让其他机器直连本进程，才改成 0.0.0.0。
NHX_HOST=127.0.0.1
NHX_PORT=8790

# ── LLM（必填）──────────────────────────────────────────────────────────────
# 默认指向 DeepSeek（OpenAI 兼容协议）。换供应商只改 BASE_URL 与 MODEL。
# 留空也能启动，只是对话接口会明确报「未配置」——便于先验证部署链路。
NHX_LLM_BASE_URL=https://api.deepseek.com/v1
NHX_LLM_API_KEY=
NHX_LLM_MODEL=deepseek-chat

# 单次请求超时（秒）与输出上限
NHX_LLM_TIMEOUT=120
NHX_LLM_MAX_TOKENS=2048
# 温度：中医问答建议 0.2~0.4，太高容易自由发挥
NHX_LLM_TEMPERATURE=0.3

# 可选：显式代理（默认直连，不走系统代理）
# 企业内网需要出网代理时才设置，例如 http://10.0.0.1:8080
# NHX_LLM_PROXY=

# ── 数据 ────────────────────────────────────────────────────────────────────
# 会话与认证数据目录（生产环境请指向持久化磁盘）
# 相对路径按「仓库根」解析，不随当前工作目录漂移
NHX_DATA_DIR=./data
# 知识库目录
NHX_KNOWLEDGE_DIR=./knowledge

# ── 认证 ────────────────────────────────────────────────────────────────────
# open      = 免登录（默认，开箱即用）
# protected = 对话需登录
# strict    = 全部接口需登录
#
# ⚠️ 对外部署务必设为 protected 或 strict，并启用 HTTPS。
# ⚠️ 设成 protected / strict 前**必须先建账号**，否则没人能登录，服务会拒绝启动：
#       python3 src/nhx_auth/auth.py adduser <用户名>
# ⚠️ 设置此变量后，CLI 的 `auth.py mode` 切换会被拒绝（避免静默无效）。
#    如需用 CLI 切换，请先注释掉这一行。
NHX_AUTH_MODE=open

# ── 安全 ────────────────────────────────────────────────────────────────────
# 输出守门（强烈建议保持开启）：即便模型失守，也会被后置校验拦下
NHX_GUARD_ENABLED=true
# block = 拦下并改写（抹去剂量、追加澄清）；warn = 仅记录
NHX_GUARD_ACTION=block

# ── 知识库检索 ──────────────────────────────────────────────────────────────
NHX_KB_ENABLED=true
NHX_KB_MAX_SNIPPETS=5

# ── 会话 ────────────────────────────────────────────────────────────────────
# 会话保留时长（秒），默认 7 天
NHX_SESSION_TTL=604800
# 送入模型的历史消息条数上限
NHX_MAX_HISTORY=20
